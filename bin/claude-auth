#!/var/jb/usr/bin/zsh
# Claude Code Authentication for iOS
# Supports API Key and OAuth (Max/Pro plan) authentication

CLAUDE_HOME="/var/jb/usr/local/lib/claude-code"
NODE_BIN="$CLAUDE_HOME/node"
CONFIG_DIR="${HOME:-/var/jb/var/mobile}/.claude"

mkdir -p "$CONFIG_DIR"

echo ""
echo "=========================================="
echo "   Claude Code iOS - Authentication"
echo "=========================================="
echo ""

# Menu
echo "Choose authentication method:"
echo ""
echo "  1) API Key (Direct API billing)"
echo "     Get your key at: https://console.anthropic.com/settings/keys"
echo ""
echo "  2) Max/Pro Plan (OAuth login)"
echo "     Uses your Claude subscription"
echo ""
echo "  3) Check current auth status"
echo ""
printf "Enter choice [1-3]: "
read choice

case "$choice" in
    1)
        echo ""
        echo "Enter your Anthropic API key:"
        echo "(starts with sk-ant-...)"
        echo ""
        printf "> "
        read -r api_key

        if [[ ! "$api_key" =~ ^sk-ant- ]]; then
            echo ""
            echo "Error: Invalid API key format. Should start with 'sk-ant-'"
            exit 1
        fi

        # Save to credentials file (sourced by claude wrapper)
        echo "export ANTHROPIC_API_KEY=\"$api_key\"" > "$CONFIG_DIR/credentials"
        chmod 600 "$CONFIG_DIR/credentials"

        # Also save as JSON for Claude Code
        cat > "$CONFIG_DIR/.credentials.json" << EOF
{
  "apiKey": "$api_key"
}
EOF
        chmod 600 "$CONFIG_DIR/.credentials.json"

        echo ""
        echo "API key saved successfully!"
        echo ""
        echo "You can now run: claude"
        ;;

    2)
        echo ""
        echo "Max/Pro Plan OAuth Login"
        echo "========================"
        echo ""

        # Create OAuth helper script
        AUTH_SCRIPT="$CONFIG_DIR/oauth-helper.js"
        cat > "$AUTH_SCRIPT" << 'OAUTHEOF'
const http = require('http');
const crypto = require('crypto');
const fs = require('fs');
const path = require('path');
const { exec } = require('child_process');

// OAuth Configuration (from Claude Code)
const OAUTH_AUTHORIZE_URL = 'https://claude.ai/oauth/authorize';
const OAUTH_TOKEN_URL = 'https://console.anthropic.com/v1/oauth/token';
const CLIENT_ID = '9d1c250a-e61b-44d9-88ed-5944d1962f5e';
const REDIRECT_URI = 'http://localhost:19283/callback';
const SCOPES = 'org:create_api_key user:profile user:inference';

const PORT = 19283;
const CONFIG_DIR = process.env.HOME + '/.claude';

// Generate PKCE values
const state = crypto.randomBytes(32).toString('hex');
const codeVerifier = crypto.randomBytes(32).toString('base64url');
const codeChallenge = crypto.createHash('sha256')
  .update(codeVerifier)
  .digest('base64url');

// Build OAuth URL
const params = new URLSearchParams({
  code: 'true',
  client_id: CLIENT_ID,
  response_type: 'code',
  redirect_uri: REDIRECT_URI,
  scope: SCOPES,
  code_challenge: codeChallenge,
  code_challenge_method: 'S256',
  state: state
});

const authUrl = `${OAUTH_AUTHORIZE_URL}?${params.toString()}`;

console.log('Starting OAuth server on port ' + PORT + '...');
console.log('');

async function exchangeCode(code) {
  const tokenParams = {
    grant_type: 'authorization_code',
    client_id: CLIENT_ID,
    code: code,
    redirect_uri: REDIRECT_URI,
    code_verifier: codeVerifier,
    state: state
  };

  const response = await fetch(OAUTH_TOKEN_URL, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'User-Agent': 'Claude-Code-iOS/1.0',
      'Accept': 'application/json',
      'Referer': 'https://claude.ai/',
      'Origin': 'https://claude.ai'
    },
    body: JSON.stringify(tokenParams)
  });

  if (!response.ok) {
    const errorText = await response.text();
    throw new Error(`Token exchange failed: ${response.status} - ${errorText}`);
  }

  return await response.json();
}

const server = http.createServer(async (req, res) => {
  const url = new URL(req.url, 'http://127.0.0.1:' + PORT);

  if (url.pathname === '/callback') {
    const code = url.searchParams.get('code');
    const returnedState = url.searchParams.get('state');
    const error = url.searchParams.get('error');

    if (error) {
      res.writeHead(200, {'Content-Type': 'text/html'});
      res.end('<html><body style="font-family:system-ui;padding:40px;text-align:center;"><h1>Authentication Failed</h1><p>' + error + '</p><p>You can close this window.</p></body></html>');
      console.log('Authentication failed:', error);
      process.exit(1);
    }

    if (returnedState !== state) {
      res.writeHead(400, {'Content-Type': 'text/html'});
      res.end('<html><body style="font-family:system-ui;padding:40px;text-align:center;"><h1>Security Error</h1><p>State mismatch - possible CSRF attack</p></body></html>');
      process.exit(1);
    }

    if (code) {
      try {
        console.log('Exchanging authorization code for tokens...');
        const tokens = await exchangeCode(code);

        // Save credentials in Claude Code format
        const credentials = {
          claudeAiOauth: {
            accessToken: tokens.access_token,
            refreshToken: tokens.refresh_token,
            expiresAt: (Math.floor(Date.now() / 1000) + tokens.expires_in) * 1000,
            scopes: tokens.scope ? tokens.scope.split(' ') : ['user:inference', 'user:profile'],
            isMax: true
          }
        };

        fs.writeFileSync(
          path.join(CONFIG_DIR, '.credentials.json'),
          JSON.stringify(credentials, null, 2)
        );

        res.writeHead(200, {'Content-Type': 'text/html'});
        res.end('<html><body style="font-family:system-ui;padding:40px;text-align:center;background:#1a1a2e;color:#fff;"><h1 style="color:#4ade80;">Authentication Successful!</h1><p>You can close this window and return to the terminal.</p><p style="color:#888;margin-top:20px;">Claude Code iOS is ready to use.</p></body></html>');

        console.log('');
        console.log('========================================');
        console.log('  Authentication successful!');
        console.log('========================================');
        console.log('');
        console.log('You can now run: claude');
        console.log('');

        setTimeout(() => process.exit(0), 1000);
      } catch (err) {
        console.error('Token exchange error:', err.message);
        res.writeHead(500, {'Content-Type': 'text/html'});
        res.end('<html><body style="font-family:system-ui;padding:40px;text-align:center;"><h1>Token Exchange Failed</h1><p>' + err.message + '</p></body></html>');
        process.exit(1);
      }
    } else {
      res.writeHead(400, {'Content-Type': 'text/html'});
      res.end('<html><body><h1>Missing authorization code</h1></body></html>');
    }
  } else {
    res.writeHead(404);
    res.end('Not found');
  }
});

server.listen(PORT, '127.0.0.1', () => {
  console.log('Opening browser for authentication...');
  console.log('');
  console.log('If browser does not open automatically, visit:');
  console.log(authUrl);
  console.log('');

  // Try to open browser on iOS
  exec('/var/jb/usr/bin/uiopen "' + authUrl + '"', { shell: '/var/jb/bin/sh' }, (err) => {
    if (err) {
      console.log('Could not auto-open browser.');
      console.log('Please copy the URL above and open it in Safari.');
    }
  });
});

// Timeout after 5 minutes
setTimeout(() => {
  console.log('');
  console.log('Authentication timed out after 5 minutes.');
  process.exit(1);
}, 300000);
OAUTHEOF

        # Run OAuth helper with minimal V8 flags
        "$NODE_BIN" --no-wasm-code-gc "$AUTH_SCRIPT"
        ;;

    3)
        echo ""
        echo "Authentication Status"
        echo "===================="
        echo ""

        if [ -f "$CONFIG_DIR/credentials" ]; then
            echo "API key configured (credentials file)"
            source "$CONFIG_DIR/credentials"
            if [ -n "$ANTHROPIC_API_KEY" ]; then
                echo "  Key: ${ANTHROPIC_API_KEY:0:12}...${ANTHROPIC_API_KEY: -4}"
            fi
        fi

        if [ -f "$CONFIG_DIR/.credentials.json" ]; then
            if grep -q "claudeAiOauth" "$CONFIG_DIR/.credentials.json" 2>/dev/null; then
                echo "OAuth credentials (Max/Pro plan)"
                # Check expiration
                EXPIRES=$(grep -o '"expiresAt":[0-9]*' "$CONFIG_DIR/.credentials.json" 2>/dev/null | cut -d: -f2)
                if [ -n "$EXPIRES" ]; then
                    NOW=$(date +%s)000
                    if [ "$EXPIRES" -gt "$NOW" ]; then
                        echo "  Status: Valid"
                    else
                        echo "  Status: Expired (run claude-auth again)"
                    fi
                fi
            elif grep -q "apiKey" "$CONFIG_DIR/.credentials.json" 2>/dev/null; then
                echo "API Key configured (.credentials.json)"
            fi
        fi

        if [ -n "$ANTHROPIC_API_KEY" ] && [ ! -f "$CONFIG_DIR/credentials" ]; then
            echo "API key set via environment variable"
            echo "  Key: ${ANTHROPIC_API_KEY:0:12}...${ANTHROPIC_API_KEY: -4}"
        fi

        if [ ! -f "$CONFIG_DIR/credentials" ] && [ ! -f "$CONFIG_DIR/.credentials.json" ] && [ -z "$ANTHROPIC_API_KEY" ]; then
            echo "Not authenticated"
            echo ""
            echo "Run 'claude-auth' and choose option 1 or 2"
        fi

        echo ""
        ;;

    *)
        echo "Invalid choice"
        exit 1
        ;;
esac
