#!/var/jb/usr/bin/zsh
# Post-installation for Claude Code iOS (2.1.112 repack of the CyPwn tweak)
echo "Setting up Claude Code..."
CC=/var/jb/usr/local/lib/claude-code
ENT="$CC/entitlements.xml"

mkdir -p /var/jb/var/mobile/.claude /var/jb/var/mobile/bin
chown -R mobile:mobile /var/jb/var/mobile/.claude
chown -R mobile:mobile "$CC"

# sign the bundled iOS node (JIT + disable-library-validation)
[ -f "$CC/node" ] && ldid -S"$ENT" "$CC/node"

# sign ripgrep WITH entitlements so the Grep tool runs on iOS
RG="$CC/node_modules/@anthropic-ai/claude-code/vendor/ripgrep/arm64-darwin/rg"
[ -f "$RG" ] && ldid -S"$ENT" "$RG"
RGN="$CC/node_modules/@anthropic-ai/claude-code/vendor/ripgrep/arm64-darwin/ripgrep.node"
[ -f "$RGN" ] && ldid -S"$ENT" "$RGN"

# PATH
ZSHRC="/var/jb/var/mobile/.zshrc"
if ! grep -q "/var/jb/usr/local/bin" "$ZSHRC" 2>/dev/null; then
    echo ''                                        >> "$ZSHRC"
    echo '# Claude Code'                            >> "$ZSHRC"
    echo 'export PATH="/var/jb/usr/local/bin:$PATH"' >> "$ZSHRC"
fi

# ssh://claude launch chain (config + dedicated key + forced command)
SETUP=/var/jb/usr/local/libexec/claude-code/setup-ssh-launch.sh
[ -x "$SETUP" ] && "$SETUP"

# home-screen app icon
APP=/var/jb/Applications/ClaudeCode.app
if [ -f "$APP/ClaudeCode" ]; then
    ldid -S"$APP/entitlements.xml" "$APP/ClaudeCode"
    chown -R root:wheel "$APP"
    chmod 755 "$APP/ClaudeCode"

    # RootHide and other trustcache-enforcing jailbreaks reject a freshly
    # re-signed binary until its cdhash is registered. `jbctl trustcache add`
    # takes the hash itself, not a path.
    if command -v jbctl >/dev/null 2>&1; then
        CDHASH=$(ldid -h "$APP/ClaudeCode" 2>/dev/null | sed -n 's/^CDHash=//p' | head -1)
        [ -n "$CDHASH" ] && jbctl trustcache add "$CDHASH" >/dev/null 2>&1 || true
    fi

    uicache -p "$APP" 2>/dev/null || true
fi

echo ""
echo "Claude Code (2.1.112) installed."
echo "  claude-auth   # sign in"
echo "  claude        # run"
echo ""
echo "Tapping the home-screen icon opens NewTerm 3 and runs Claude Code"
echo "over ssh://claude. NewTerm 3 must be installed."
exit 0
